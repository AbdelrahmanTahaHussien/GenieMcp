{
  "name": "graphdoc-mcp",
  "version": "1.0.8",
  "description": "MCP server that onboards developers and AI agents onto any React codebase (Next.js, Remix, Vite, CRA)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "graphdoc-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "npm run build && node dist/index.js --setup",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "tsc && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "oxc-parser": "^0.133.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.9.4",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "mcp",
    "documentation",
    "onboarding",
    "component-tree",
    "vscode",
    "cursor",
    "react"
  ],
  "license": "MIT"
}
